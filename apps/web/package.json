{
	"name": "@hive/web",
	"version": "0.1.0",
	"author": "killbasa <git@killbasa.com>",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --enable-source-maps dist/index.js",
		"sync": "svelte-kit sync",
		"check": "yarn sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint --fix",
		"format": "prettier --write .",
		"test": "vitest --coverage --run",
		"test:watch": "vitest --watch",
		"openapi": "openapi-typescript ../api/openapi.json -o ./src/api.d.ts",
		"regen": "turbo --filter @hive/api run openapi && openapi-typescript ../api/openapi.json -o ./src/api.d.ts",
		"clean": "rm -rf ./.svelte-kit ./.turbo ./dist ./node_modules"
	},
	"dependencies": {
		"@fastify/static": "^9.0.0",
		"@hive/common": "workspace:^",
		"@lucide/svelte": "^0.577.0",
		"@sveltejs/kit": "^2.55.0",
		"cron-schedule": "^6.0.0",
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@hive/eslint-config": "workspace:^",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "4.2.2",
		"@types/node": "^25.5.0",
		"@typescript-eslint/utils": "^8.57.1",
		"@vitest/coverage-v8": "4.1.0",
		"daisyui": "5.5.19",
		"eslint": "9.39.4",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.5",
		"tailwindcss": "4.2.2",
		"typescript": "5.9.3",
		"vite": "7.3.1",
		"vitest": "^4.1.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix"
		],
		"*.{js,ts,json,html}": [
			"prettier --write --log-level=warn \"**/*.{js,ts,json,html}\""
		]
	},
	"engines": {
		"node": "25.x"
	},
	"packageManager": "yarn@4.13.0",
	"volta": {
		"node": "25.8.1"
	}
}
