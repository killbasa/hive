{
	"name": "@hive/api",
	"version": "0.1.0",
	"author": "killbasa <git@killbasa.com>",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"files": [
		"db",
		"dist/main.js",
		"dist/main.js.map",
		"static"
	],
	"scripts": {
		"build": "yarn check && NODE_ENV=development tsup",
		"build:prod": "yarn check && tsup",
		"start": "node --enable-source-maps dist/main.js",
		"profile": "node --enable-source-maps --inspect dist/main.js",
		"check": "tsc",
		"lint": "eslint --fix",
		"format": "prettier --write .",
		"test": "vitest --project=unit --coverage --run",
		"test:watch": "vitest --project=unit --watch",
		"test:purge": "rm -rf node_modules/.cache/hive",
		"e2e": "vitest --project=e2e --coverage --run",
		"e2e:watch": "vitest --project=e2e --watch",
		"dry-run": "yarn check && yarn build && yarn test",
		"generate": "drizzle-kit generate",
		"flush": "redis-cli --pass password flushall",
		"reset": "yarn flush && tsx scripts/reset.ts",
		"reset:videos": "tsx scripts/reset-videos.ts",
		"reset:users": "tsx scripts/reset-users.ts",
		"openapi": "tsx scripts/gen.ts",
		"clean": "rm -rf ./.turbo ./dist ./node_modules"
	},
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.2.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/session": "^11.1.1",
		"@fastify/swagger": "^9.7.0",
		"@fastify/type-provider-typebox": "^6.1.0",
		"@fastify/websocket": "^11.2.0",
		"@hive/common": "workspace:^",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/exporter-prometheus": "^0.213.0",
		"@opentelemetry/sdk-node": "^0.213.0",
		"@opentelemetry/semantic-conventions": "^1.40.0",
		"@scalar/api-reference": "^1.49.1",
		"@scalar/types": "^0.7.4",
		"argon2": "^0.44.0",
		"better-sqlite3": "^12.8.0",
		"bullmq": "^5.71.0",
		"cron-schedule": "^6.0.0",
		"drizzle-orm": "^0.45.1",
		"fast-xml-parser": "^5.5.7",
		"fastify": "^5.8.2",
		"ioredis": "^5.10.1",
		"pino-pretty": "^13.1.3",
		"typebox": "^1.1.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@killbasa/ts-config": "^1.0.0",
		"@swc/core": "1.15.18",
		"@types/better-sqlite3": "^7.6.13",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "4.1.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "9.39.4",
		"prettier": "^3.8.1",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "5.9.3",
		"vitest": "4.1.0"
	},
	"lint-staged": {
		"*.{js,cjs,ts}": [
			"eslint --fix"
		],
		"*.{js,cjs,ts,json,html,yml}": [
			"prettier --write --log-level=warn \"**/*.{js,cjs,ts,json,html,yml}\""
		]
	},
	"engines": {
		"node": "25.x"
	},
	"packageManager": "yarn@4.13.0",
	"volta": {
		"node": "25.8.1"
	}
}
