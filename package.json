{
	"name": "monorepo",
	"version": "0.1.0",
	"author": "killbasa <git@killbasa.com>",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/killbasa/hive.git"
	},
	"homepage": "https://github.com/killbasa/hive",
	"scripts": {
		"bootstrap": "yarn install && ./apps/api/scripts/deps.sh && yarn build",
		"build": "turbo run build",
		"openapi": "turbo run openapi",
		"check": "turbo run check",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"test": "turbo run test",
		"e2e": "turbo run e2e",
		"dry-run": "yarn openapi && yarn build && yarn check && yarn lint && yarn format && yarn test && yarn e2e"
	},
	"devDependencies": {
		"@hive/eslint-config": "workspace:^",
		"@killbasa/prettier-config": "^1.0.2",
		"@killbasa/ts-config": "^1.0.0",
		"@types/node": "^25.5.0",
		"eslint": "9.39.4",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"turbo": "2.8.20",
		"typescript": "5.9.3",
		"vitest": "4.1.0"
	},
	"resolutions": {
		"vite": "8.0.1"
	},
	"lint-staged": {
		"*.{js,cjs}": [
			"eslint --fix"
		],
		"*.{js,cjs,json,yml,yaml}": [
			"prettier --write --log-level=warn \"**/*.{js,cjs,json,yml,yaml}\""
		]
	},
	"engines": {
		"node": "25.x"
	},
	"packageManager": "yarn@4.13.0",
	"volta": {
		"node": "25.8.1"
	},
	"dependenciesMeta": {
		"@swc/core": {
			"built": true
		},
		"@tailwindcss/oxide": {
			"built": true
		},
		"argon2": {
			"built": true
		},
		"better-sqlite3": {
			"built": true
		},
		"esbuild": {
			"built": true
		},
		"msgpackr-extract": {
			"built": true
		},
		"protobufjs": {
			"built": true
		},
		"unrs-resolver": {
			"built": true
		},
		"vue-demi": {
			"built": true
		}
	}
}
